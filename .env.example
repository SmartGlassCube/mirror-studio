# Server-side only (Vercel project settings -> Environment Variables). Never VITE_-prefixed:
# that would ship the key to every browser.
GEMINI_API_KEY=
# Optional: the model the shared assistant uses (default gemini-flash-lite-latest).
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional: requests per IP per hour on the shared key (default 30).
# ASSISTANT_RATE_LIMIT=30
